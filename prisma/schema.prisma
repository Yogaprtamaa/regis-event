generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  FREE
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid()) @map("_id")
  nama      String
  email     String
  nim       String?  @unique
  wa        String?  @unique
  status    String
  jurusan   String
  angkatan  String?
  createdAt DateTime @default(now())

  @@map("users")
}

model Event {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  nama_event   String
  deskripsi    String?
  tanggal      DateTime
  jam_mulai    String
  jam_berakhir String
  lokasi       String
  kapasitas    Int?

  isPaidEvent Boolean @default(false)

  createdAt    DateTime      @default(now())
  participants Participant[]

  @@map("events")
}

model Participant {
  id       String   @id @default(auto()) @map("_id") @db.ObjectId
  nama     String
  email    String
  nim      String?
  no_wa    String
  jurusan  String?
  angkatan String?
  status   String
  role     String @default("PESERTA")

  instansi String?
  divisi String?

  buktiPembayaran String?
  paymentStatus PaymentStatus @default(FREE)

  eventId String @db.ObjectId
  event   Event  @relation(fields: [eventId], references: [id])

  createdAt DateTime @default(now())

  @@map("participants")
}
