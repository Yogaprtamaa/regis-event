// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PaymentStatus {
  FREE
  PENDING
  APPROVED
  REJECTED
}

enum LombaKategori {
  HACKATHON
  KTI
  IOT
  GAME_MAKING
}

enum SubmissionStatus {
  SUBMITTED
  LOLOS_SELEKSI
  TIDAK_LOLOS
}

model User {
  id        String   @id @default(cuid())
  nama      String
  email     String
  nim       String?  @unique
  wa        String?  @unique
  status    String
  jurusan   String
  angkatan  String?
  createdAt DateTime @default(now())
}

model Event {
  id           String   @id @default(uuid())
  nama_event   String
  deskripsi    String?
  tanggal      DateTime
  jam_mulai    String
  jam_berakhir String
  lokasi       String
  kapasitas    Int?

  isPaidEvent Boolean @default(false)

  // Dilampirkan admin setelah peserta daftar (buku panduan + grup WA)
  panduanUrl  String?
  waGroupLink String?

  // Form-builder: skema kolom formulir pendaftaran. null = pakai DEFAULT_FORM_SCHEMA (lib/formSchema.js)
  formSchema Json?

  createdAt    DateTime      @default(now())
  participants Participant[]
}

model Participant {
  id       Int    @id @default(autoincrement())
  nama     String
  email    String
  nim      String?
  no_wa    String
  jurusan  String?
  angkatan String?
  status   String
  role     String @default("PESERTA")

  instansi String?
  divisi String?

  // ── IT FEST 6.0 — pendaftaran lomba ──
  jenisPeserta String?  // "individu" | "kelompok"
  universitas  String?
  fakultas     String?
  kotaDomisili String?
  provinsi     String?
  anggota      Json?    // [{ nama, nim }] — seluruh anggota termasuk ketua
  buktiFollow  String?  // URL screenshot follow IG
  fotoKtm      Json?    // [url, ...] KTM seluruh anggota

  buktiPembayaran String?
  paymentStatus PaymentStatus @default(FREE)
  // Alasan panitia saat reject (atau catatan verifikasi lain)
  catatanVerifikasi String?

  // Akun login peserta (Supabase auth user id). Peserta = user Supabase yang
  // ke-link ke baris ini; sisanya dianggap panitia. Lihat lib/auth-role.js.
  supabaseId String? @unique

  // KTI punya persyaratan lomba sendiri — checkbox persetujuan wajib buat event KTI.
  setujuSyaratKti Boolean @default(false)

  // Jawaban field custom form-builder (kolom di luar kolom bawaan) → { fieldId: value|url|[url] }
  formData Json?

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  createdAt DateTime @default(now())
}

// ── Alur penjurian lomba ──

// Akun juri — 1 baris = 1 juri dengan 1 kategori, id disambungkan ke Supabase auth user
model Juri {
  id         String        @id @default(cuid())
  supabaseId String        @unique
  nama       String
  email      String        @unique
  kategori   LombaKategori
  createdAt  DateTime      @default(now())

  scores Score[]
}

// Karya yang dikumpulkan peserta per kategori lomba
model Submission {
  id           String           @id @default(cuid())
  kategori     LombaKategori
  namaTim      String
  ketuaNama    String
  ketuaNim     String?
  ketuaEmail   String
  anggota      Json? // [{ nama, nim }]
  judulKarya   String
  deskripsi    String?
  fileKaryaUrl String
  status       SubmissionStatus @default(SUBMITTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scores Score[]

  @@index([kategori, status])
}

// Kriteria + bobot penilaian, dikelola panitia per kategori
model Criteria {
  id        String        @id @default(cuid())
  kategori  LombaKategori
  nama      String
  bobot     Float // persen, mis. 30 untuk 30%
  createdAt DateTime      @default(now())

  scoreItems ScoreItem[]

  @@index([kategori])
}

// 1 juri menilai 1 submission = 1 Score (berisi banyak ScoreItem per kriteria)
model Score {
  id           String   @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  juriId       String
  juri         Juri       @relation(fields: [juriId], references: [id], onDelete: Cascade)
  catatan      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ScoreItem[]

  @@unique([submissionId, juriId])
}

model ScoreItem {
  id         String   @id @default(cuid())
  scoreId    String
  score      Score    @relation(fields: [scoreId], references: [id], onDelete: Cascade)
  criteriaId String
  criteria   Criteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)
  nilai      Float // 0-100 buat kriteria ini

  @@unique([scoreId, criteriaId])
}

// Gerbang publikasi finalis per kategori — ranking kehitung otomatis, publish manual
model FinalistPublish {
  id          String        @id @default(cuid())
  kategori    LombaKategori @unique
  published   Boolean       @default(false)
  publishedAt DateTime?
}
