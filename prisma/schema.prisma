// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PaymentStatus {
  FREE
  PENDING
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(cuid())
  nama      String
  email     String
  nim       String?  @unique
  wa        String?  @unique
  status    String
  jurusan   String
  angkatan  String?
  createdAt DateTime @default(now())
}

model Event {
  id           String   @id @default(uuid())
  nama_event   String
  deskripsi    String?
  tanggal      DateTime
  jam_mulai    String
  jam_berakhir String
  lokasi       String
  kapasitas    Int?

  isPaidEvent Boolean @default(false)

  createdAt    DateTime      @default(now())
  participants Participant[]
}

model Participant {
  id       Int    @id @default(autoincrement())
  nama     String
  email    String
  nim      String?
  no_wa    String
  jurusan  String?
  angkatan String?
  status   String
  role     String @default("PESERTA")

  instansi String?
  divisi String?

  // ── IT FEST 6.0 — pendaftaran lomba ──
  jenisPeserta String?  // "individu" | "kelompok"
  universitas  String?
  fakultas     String?
  kotaDomisili String?
  provinsi     String?
  anggota      Json?    // [{ nama, nim }] — seluruh anggota termasuk ketua
  buktiFollow  String?  // URL screenshot follow IG
  fotoKtm      Json?    // [url, ...] KTM seluruh anggota

  buktiPembayaran String?
  paymentStatus PaymentStatus @default(FREE)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  createdAt DateTime @default(now())
}
